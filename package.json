{
  "name": "@starlightcms/js-sdk",
  "version": "4.0.0-beta.3",
  "description": "The Starlight SDK for JavaScript",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "docs": "npm start -w website",
    "docs:build": "npm run build -w website",
    "docs:serve": "npm run serve -w website",
    "prepare": "husky install",
    "prepublishOnly": "npm run build",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "type-check": "tsc --pretty --noEmit",
    "lint": "eslint src"
  },
  "files": [
    "dist/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starlightcms/js-sdk.git"
  },
  "keywords": [
    "starlight",
    "sdk"
  ],
  "author": "Lucas Varela <hi@lucasvarela.dev>",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/starlightcms/js-sdk/issues"
  },
  "homepage": "https://github.com/starlightcms/js-sdk#readme",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@types/node": "^24.10.3",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "cross-fetch": "^3.1.5",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "husky": "^7.0.2",
    "jsdom": "^27.3.0",
    "lint-staged": "^11.1.2",
    "msw": "^2.12.4",
    "prettier": "^3.7.4",
    "tsdown": "^0.21.5",
    "type-fest": "5.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "inlinedDependencies": {
    "tagged-tag": "1.0.0",
    "type-fest": "5.5.0"
  },
  "lint-staged": {
    "*.{ts}": [
      "vitest --passWithNoTests",
      "eslint --cache --fix",
      "prettier --write"
    ]
  }
}
